<?php

/**
 * @file
 * Analyze AI Content Security Audit module for security-focused analysis.
 *
 * This module provides AI-powered content security risk analysis identifying
 * potential PII disclosure, credential exposure, and sensitive leaks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\analyze_ai_content_security_audit\Hook\AnalyzeAiContentSecurityAuditHooks;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_view().
 */
#[LegacyHook]
function analyze_ai_content_security_audit_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  \Drupal::service(AnalyzeAiContentSecurityAuditHooks::class)->viewsPreView($view, $display_id, $args);
}

/**
 * Implements hook_views_color_scale_popover_alter().
 */
#[LegacyHook]
function analyze_ai_content_security_audit_views_color_scale_popover_alter(array &$content, array $context): void {
  \Drupal::service(AnalyzeAiContentSecurityAuditHooks::class)->viewsColorScalePopoverAlter($content, $context);
}
